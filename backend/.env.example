# Server Port
PORT=5000

# Client Application URL (For CORS)
CLIENT_URL=https://manebz.com/,http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Environment mode
NODE_ENV=development

# Admin Panel Authentication
# Email the bootstrap owner account signs in with.
ADMIN_EMAIL=admin@manebz.com
# Password for that account. Use a long, unique value.
ADMIN_PASSWORD=change_me_to_a_strong_password
# Random 64-char hex. Generate with: node -e "console.log(require("crypto").randomBytes(32).toString("hex"))"
ADMIN_TOKEN_SECRET=change_me_to_a_random_64_char_hex_string
# How long an admin stays logged in
ADMIN_TOKEN_TTL_HOURS=12

# Uploaded Media Folder (absolute path or relative to backend/)
# UPLOAD_DIR=/home/USER/public_html/uploads
