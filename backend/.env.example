# Server Port
PORT=5000

# Client Application URL (For CORS)
CLIENT_URL=https://manebz.com/,http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Environment mode
NODE_ENV=development

# Admin Panel Authentication
# Email the bootstrap owner account signs in with.
ADMIN_EMAIL=admin@manebz.com
# Password for that account. Use a long, unique value.
ADMIN_PASSWORD=change_me_to_a_strong_password
# Random 64-char hex. Generate with: node -e "console.log(require("crypto").randomBytes(32).toString("hex"))"
ADMIN_TOKEN_SECRET=change_me_to_a_random_64_char_hex_string
# How long an admin stays logged in
ADMIN_TOKEN_TTL_HOURS=12

# Uploaded Media Folder (absolute path or relative to backend/)
# UPLOAD_DIR=/home/USER/public_html/uploads

# SMTP / Nodemailer Email Configuration
# Examples:
# For Gmail: SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=yourgmail@gmail.com | SMTP_PASS=your_16_char_app_password
# For cPanel Webmail: SMTP_HOST=mail.manebz.com | SMTP_PORT=465 | SMTP_SECURE=true | SMTP_USER=info@manebz.com | SMTP_PASS=your_email_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MANEBZ Portal <info@manebz.com>"
MAIL_TO=info@manebz.com
